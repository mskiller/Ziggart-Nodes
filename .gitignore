# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest / coverage
.pytest_cache/
.coverage

# OS generated files
.DS_Store
Thumbs.db

# Virtual environments
venv/
.venv/

# Local index cache and test outputs
.cache/
output/

# Keep the wildcards/ folder in git, but ignore user's 700+ MB wildcard files inside it
wildcards/*
!wildcards/.gitkeep
